# Reused from ../../target/personalization-hybrid's own .env — a real,
# already-configured Target activity ("alloy-samples sample-json-offer")
# that this repo's maintainers keep live for exactly this kind of demo.
# EDGE_CONFIG_ID_WITHOUT_ANALYTICS there, specifically: avoids this sample's
# personalization-fetch request from double-counting as a page view.
ORG_ID="97D1F3F459CE0AD80A495CBE@AdobeOrg"
DATASTREAM_ID="73690cda-9d47-4d55-b669-2d027dc01d19"
EDGE_DOMAIN="edge.adobedc.net"
EDGE_BASE_PATH="ee"

# Target-style decision scope (e.g. an mbox name).
DECISION_SCOPE="sample-json-offer"

# AJO-style surface URI. Leave blank to only request DECISION_SCOPE.
SURFACE=

PORT=4300
