<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{pageTitle}}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="container py-5">
    <h1>Node Server-side Data Collection Sample</h1>
    <p class="lead">
      Powered by <a href="https://github.com/adobe/alloy/tree/main/packages/node"><code>@adobe/alloy-node</code></a>.
      No client-side <code>alloy.js</code> here either — this page's load
      already recorded a <code>web.webpagedetails.pageViews</code> event
      server-side. Each button below hits <code>POST /track</code>, which
      records its own event the same way.
    </p>

    {{#if error}}
    <div class="alert alert-danger" role="alert">
      <h4 class="alert-heading">&#128565; There was an error</h4>
      {{error}}
    </div>
    {{else}}
    <div class="alert alert-info" role="alert">
      This visitor's ECID: <code id="ecid">{{ecid}}</code>. Every event
      below — the page view above and every button click — resolves to
      this same ECID, even though each is backed by its own
      <code>forRequest()</code> call.
    </div>

    <div id="event-log" class="mb-3"></div>

    <div id="action-buttons">
      {{#each buttonActions}}
      <button
        type="button"
        class="btn btn-primary me-2"
        data-event-type="{{eventType}}"
      >{{text}}</button>
      {{/each}}
    </div>
    {{/if}}
  </div>

  <script src="script.js"></script>
</body>
</html>
